{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/NextCommerceCo/campaign-cart-starter-templates/main/schemas/template-verification-manifest.v0.schema.json",
  "title": "NEXT template verification manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "visibility",
    "source",
    "verification",
    "families"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schema_version": { "const": "template-verification-manifest/v0" },
    "repository": { "type": "string", "minLength": 1 },
    "visibility": { "enum": ["public", "private"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "digest", "verified_at"],
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "checks"],
      "properties": {
        "scope": { "const": "template_contract_ci" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "url", "completed_at"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "const": "passed" },
              "url": { "type": "string", "format": "uri" },
              "completed_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "families": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/family" }
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sdk_version",
        "verification_status",
        "campaigns_os_status",
        "distribution",
        "source_path"
      ],
      "properties": {
        "kind": { "enum": ["commerce_family", "section_library"] },
        "sdk_version": { "type": "string", "pattern": "^0\\.4\\.[0-9]+$" },
        "verification_status": { "enum": ["verified", "candidate", "superseded"] },
        "campaigns_os_status": { "enum": ["certified", "candidate", "not_applicable"] },
        "distribution": { "enum": ["public_picker", "private_picker", "not_in_picker"] },
        "source_path": { "type": "string", "pattern": "^src/[a-z0-9-]+$" }
      }
    }
  }
}
